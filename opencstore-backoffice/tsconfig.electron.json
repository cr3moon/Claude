{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["backend/*"],
      "@database/*": ["database/*"],
      "@integrations/*": ["integrations/*"],
      "@audit/*": ["audit/*"]
    }
  },
  "include": [
    "app/main/**/*",
    "app/preload/**/*",
    "backend/**/*",
    "database/**/*",
    "integrations/**/*",
    "reports/**/*",
    "pricing/**/*",
    "audit/**/*"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "app/renderer"]
}
